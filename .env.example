# MiniRack Management Portal - Environment Variables Configuration
# Copy this file to .env and modify the values to match your environment
# 
# IMPORTANT: All IP addresses and hostnames below are configurable to support
# different network environments. Update them to match your actual network setup.

# ============================================================================
# Server Configuration
# ============================================================================
DEBUG=false                           # Set to true for development debugging
HOST=0.0.0.0                         # Bind address (0.0.0.0 listens on all interfaces)
PORT=8080                            # Web server port
LOG_LEVEL=INFO                       # Logging level: DEBUG, INFO, WARNING, ERROR

# ============================================================================
# Security Configuration
# ============================================================================
API_KEY_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Origins (comma-separated list or ["*"] for all origins)
# Production should restrict this to specific domains
CORS_ORIGINS=["*"]

# ============================================================================
# MiniRack Host Configuration
# IMPORTANT: Update these IP addresses/hostnames to match your network setup
# ============================================================================

# LaForge (ai-utility) - Management and monitoring host
# This is where the management portal typically runs
LAFORGE_HOST=192.168.1.161          # Update to your LaForge IP address
LAFORGE_SSH_USER=localadmin         # SSH user for remote access
LAFORGE_SSH_PORT=22                 # SSH port (default: 22)

# Data (ai-core) - Ollama LLM runtime host
# This host runs the Ollama service with LLM models
DATA_HOST=192.168.1.160             # Update to your Data (ai-core) IP address
OLLAMA_API_HOST=http://192.168.1.160:11434  # Ollama API endpoint (port 11434)
# To access via hostname instead: http://data-host:11434

# Riker (ai-web) - Open WebUI and agent interface host
# This host runs the web interface and AI agents
RIKER_HOST=192.168.1.162            # Update to your Riker (ai-web) IP address
OPENWEB_UI_URL=http://192.168.1.162:8000   # Open WebUI endpoint (port 8000)
# To access via hostname instead: http://riker-host:8000

# ============================================================================
# Example Alternative Network Configuration
# ============================================================================
# If your hosts are on a different subnet or use hostnames:
#
# LAFORGE_HOST=laforge.local
# DATA_HOST=data.local
# RIKER_HOST=riker.local
# OLLAMA_API_HOST=http://data.local:11434
# OPENWEB_UI_URL=http://riker.local:8000
#
# Or if running on 10.0.0.0/24 subnet:
#
# LAFORGE_HOST=10.0.0.161
# DATA_HOST=10.0.0.160
# RIKER_HOST=10.0.0.162
# OLLAMA_API_HOST=http://10.0.0.160:11434
# OPENWEB_UI_URL=http://10.0.0.162:8000

# ============================================================================
# Monitoring Configuration
# ============================================================================
PROMETHEUS_ENABLED=true             # Enable Prometheus metrics endpoint
HEALTH_CHECK_INTERVAL=30            # Health check interval in seconds
METRICS_RETENTION_HOURS=24          # How long to retain historical metrics
